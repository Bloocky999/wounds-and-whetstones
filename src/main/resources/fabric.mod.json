{
  "schemaVersion": 1,
  "id": "pandemonium",
  "version": "${version}",
  "name": "Wounds & Whetstones",
  "description": "Supervivencia con enfermedades, fobias, discapacidades, moodles y metalurgia de armas forjadas.",
  "authors": [],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.pandemonium.Pandemonium"
    ],
    "client": [
      "dev.pandemonium.client.PandemoniumClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    {
      "config": "pandemonium.mixins.json",
      "environment": "client"
    },
    {
      "config": "pandemonium.common.mixins.json"
    }
  ]
}

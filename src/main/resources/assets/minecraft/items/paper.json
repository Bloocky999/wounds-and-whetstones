{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pandemonium_mask",
        "model": {
          "type": "minecraft:model",
          "model": "pandemonium:item/mask"
        }
      },
      {
        "when": "pandemonium_filter",
        "model": {
          "type": "minecraft:model",
          "model": "pandemonium:item/filter"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/paper"
    }
  }
}